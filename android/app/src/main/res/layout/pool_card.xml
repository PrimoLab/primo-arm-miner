<?xml version="1.0" encoding="utf-8"?>
<!-- One pool entry on the config page (primary or failover). Inflated into
     @id/poolContainer by ConfigActivity; the title/remove row is rebound as
     cards are added/removed so numbering stays consecutive. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/stat_tile"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView android:id="@+id/poolTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PRIMARY POOL"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView android:id="@+id/poolRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="REMOVE"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <TextView style="@style/FieldLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="POOL URL" />
    <EditText android:id="@+id/poolUrl" style="@style/FieldInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textUri"
        android:hint="stratum+tcp://host:port" />

    <TextView style="@style/FieldLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="WALLET / USER.WORKER" />
    <EditText android:id="@+id/poolUser" style="@style/FieldInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="wallet.worker" />

    <TextView style="@style/FieldLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PASSWORD" />
    <EditText android:id="@+id/poolPass" style="@style/FieldInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="x" />
</LinearLayout>
