<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: a CPU chip (teal ring + pins) with an energy bolt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- chip body as a ring (outer square minus inner square) -->
    <path
        android:fillColor="#19E3A1"
        android:fillType="evenOdd"
        android:pathData="M34,34 h40 v40 h-40 z M44,44 h20 v20 h-20 z" />

    <!-- pins -->
    <path
        android:fillColor="#19E3A1"
        android:pathData="M41,27 h4 v7 h-4 z M52,27 h4 v7 h-4 z M63,27 h4 v7 h-4 z
                          M41,74 h4 v7 h-4 z M52,74 h4 v7 h-4 z M63,74 h4 v7 h-4 z
                          M27,41 h7 v4 h-7 z M27,52 h7 v4 h-7 z M27,63 h7 v4 h-7 z
                          M74,41 h7 v4 h-7 z M74,52 h7 v4 h-7 z M74,63 h7 v4 h-7 z" />

    <!-- energy bolt in the core -->
    <path
        android:fillColor="#F2F4F8"
        android:pathData="M55,44 L47,56 L53,56 L51,64 L60,51 L54,51 Z" />
</vector>
